---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import LinkedinIcon from '../components/icons/LinkedinIcon.astro';
import SocialPill from '../components/icons/SocialPill.astro';
import GithubIcon from '../components/icons/Github.astro';
import MailIcon from '../components/icons/Mail.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Experience from '../components/Experience.astro';
import Briefcase from '../components/icons/Briefcase.astro';
---

<Layout title="Portafolio de Sebas Cabascango - Ingeniero de Software"
description='Contrata a Sebas para crear tu apliación web o para realizar tu proyecto de machine learning.'
>
	<main>
		<SectionContainer class="py-44 pb-22">
			<img  class="rounded-full w-12 h-12 mb-4"
			src="https://th.bing.com/th/id/OIP.EA9angBkH62Aemz70-YahwAAAA?pid=ImgDet&rs=1"
			 alt="sebas photo">
		<h1 class="text-white text-5xl font-bold flex flex-row gap-x-4 pb-10">
			Hola soy el Sebastian<a
			href="https://www.linkedin.com/in/sebastiancabascango"
			target="_blank"
			rel="noreferrer"
			class="flex justify-center items-center"> 
			<Badge>Disponible para trabajar</Badge>
			</a>
		</h1>
		<h2 class="text-2xl text-wrap">
			<span>💻 10 años de experiencia.</span>
			<span 
			class="text-yellow-200/90"
			> Desarrollador Web.</span>	

			<span class="text-red-200/90"> De Cotacachi, Ecuador 💚.</span>
			<span class="opacity-75">Especializado en Ciencia de Datos 📊.
			</span>
			
		</h2>
		<nav class="flex gap-x-4 mt-8">
			<SocialPill href="https://www.linkedin.com/in/sebastiancabascango" target="_blank">
				<LinkedinIcon class="size-6" />
				Linkedin
			</SocialPill>
			<SocialPill href="https://github.com/eudycss" target="_blank">
				<GithubIcon class="size-6" />
				Github
			</SocialPill>
			<SocialPill href="#" target="_blank">
				<MailIcon class="size-6" />
				escabascango@gmail.com
			</SocialPill>
		</nav>
		</SectionContainer>
		
<SectionContainer id="experiencia">
	<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 item-center">
		<Briefcase class="size-7"/>
		Experiencia Laboral	</h2>
	<Experience/>
	</SectionContainer>
			
	</main>
</Layout>

